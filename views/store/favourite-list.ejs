<%- include('../partials/head') %>

</head>

<body class="bg-slate-100 min-h-screen">

<%- include('../partials/nav') %>

<main class="max-w-7xl mx-auto px-4 py-10">

  <!-- Header -->

  <div class="text-center mb-10">


<span class="inline-block px-3 py-1 bg-rose-100 text-rose-600 text-xs font-bold rounded-full mb-4">
  YOUR COLLECTION
</span>

<h1 class="text-4xl font-bold text-slate-900 mb-3">
  Favorite Properties
</h1>

<p class="text-slate-600 text-lg">
  Your curated list of dream destinations
</p>


  </div>

<% if (favouriteHomes.length === 0) { %>


<!-- Empty State -->
<div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-xl p-10 text-center">

  <div class="text-7xl mb-6">
    ❤️
  </div>

  <h2 class="text-3xl font-bold text-slate-900 mb-4">
    No Favorites Yet
  </h2>

  <p class="text-slate-600 mb-8">
    You haven't added any properties to your favorites yet.
    Explore homes and save the ones you love.
  </p>

  <a
    href="/homes"
    class="inline-flex items-center gap-2 bg-rose-600 hover:bg-rose-700 text-white px-6 py-3 rounded-lg font-semibold transition"
  >
    Explore Homes
  </a>

</div>


<% } else { %>


<!-- Grid -->
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">

  <% favouriteHomes.forEach((home) => { %>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300">

      <!-- Image -->
      <div class="relative">

        <img
          src="<%= home.photo %>"
          alt="<%= home.homeName %>"
          onerror="this.src='https://placehold.co/600x400?text=Property'"
          class="w-full h-56 object-cover"
        />

        <div class="absolute top-3 right-3">
          <span class="bg-rose-600 text-white text-xs px-3 py-1 rounded-full font-medium">
            ❤️ Favorite
          </span>
        </div>

      </div>

      <!-- Content -->
      <div class="p-6">

        <h3 class="text-xl font-bold text-slate-900 mb-2">
          <%= home.homeName %>
        </h3>

        <p class="text-slate-500 mb-4">
          📍 <%= home.location %>
        </p>

        <div class="flex justify-between items-center mb-6">

          <div>
            <p class="text-xs text-slate-500">
              From
            </p>

            <p class="text-xl font-bold text-rose-600">
              ₹<%= home.price %>
            </p>
          </div>

          <div class="text-right">
            <p class="text-xs text-slate-500">
              Rating
            </p>

            <p class="font-bold text-yellow-500">
              ⭐ <%= home.rating %>
            </p>
          </div>

        </div>

        <!-- Actions -->
        <div class="grid grid-cols-2 gap-3">

          <a
            href="/store/home/<%= home._id %>"
            class="text-center bg-rose-600 hover:bg-rose-700 text-white py-2 rounded-lg font-medium transition"
          >
            View
          </a>

          <form
            action="/favourites/delete/<%= home._id %>"
            method="POST"
          >

            <input
              type="hidden"
              name="homeId"
              value="<%= home._id %>"
            />

            <button
              type="submit"
              onclick="return confirm('Remove from favorites?');"
              class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg font-medium transition"
            >
              Remove
            </button>

          </form>

        </div>

      </div>

    </div>

  <% }) %>

</div>


<% } %>

</main>

</body>
</html>
