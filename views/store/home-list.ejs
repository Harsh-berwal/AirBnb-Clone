<%- include('../partials/head') %>

</head>

<body class="bg-slate-100 min-h-screen">

<%- include('../partials/nav') %>

<!-- Header -->

<section class="bg-white border-b border-slate-200">

  <div class="max-w-7xl mx-auto px-4 py-12">


<h1 class="text-5xl font-bold text-slate-900 mb-3">
  Explore Properties
</h1>

<p class="text-xl text-slate-600 mb-6">
  Find the perfect home for your next adventure
</p>

<div class="inline-block bg-rose-50 border border-rose-200 px-4 py-2 rounded-lg">
  <span class="text-slate-700">
    Showing
    <span class="font-bold">
      <%= registeredHomes.length %>
    </span>
    <%= registeredHomes.length === 1 ? 'property' : 'properties' %>
  </span>
</div>


  </div>

</section>

<!-- Homes -->

<section class="max-w-7xl mx-auto px-4 py-12">

<% if (registeredHomes.length === 0) { %>


<div class="bg-white rounded-2xl shadow-lg p-12 text-center">

  <div class="text-7xl mb-6">
    🏠
  </div>

  <h2 class="text-3xl font-bold text-slate-900 mb-4">
    No Properties Available
  </h2>

  <p class="text-slate-600 mb-8">
    There are no properties available right now.
  </p>

  <a
    href="/"
    class="inline-block bg-rose-600 hover:bg-rose-700 text-white px-6 py-3 rounded-lg font-semibold transition"
  >
    Back to Home
  </a>

</div>


<% } else { %>

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">

  <% registeredHomes.forEach((home) => { %>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300">

      <!-- Image -->
      <img
        src="<%= home.photo %>"
        alt="<%= home.homeName %>"
        onerror="this.src='https://placehold.co/600x400?text=Property'"
        class="w-full h-60 object-cover"
      />

      <!-- Content -->
      <div class="p-6">

        <h3 class="text-xl font-bold text-slate-900 mb-2">
          <%= home.homeName %>
        </h3>

        <p class="text-slate-500 mb-3">
          📍 <%= home.location %>
        </p>

        <% if (home.description) { %>
          <p class="text-sm text-slate-600 mb-4 line-clamp-2">
            <%= home.description %>
          </p>
        <% } %>

        <div class="flex justify-between items-center mb-6">

          <div>
            <p class="text-xs text-slate-500">
              From
            </p>

            <p class="text-xl font-bold text-rose-600">
              ₹<%= home.price %>
            </p>
          </div>

          <div class="text-right">
            <p class="text-xs text-slate-500">
              Rating
            </p>

            <p class="font-bold text-yellow-500">
              ⭐ <%= home.rating %>
            </p>
          </div>

        </div>

        <!-- Actions -->
        <div class="grid grid-cols-2 gap-3">

          <a
            href="/store/home/<%= home._id %>"
            class="text-center bg-rose-600 hover:bg-rose-700 text-white py-2 rounded-lg font-medium transition"
          >
            View
          </a>

          <div>
            <%- include('../partials/favourite', { home: home }) %>
          </div>

        </div>

      </div>

    </div>

  <% }) %>

</div>
<% } %>

</section>

</body>
</html>
