<%- include('../partials/head') %>

</head>

<body class="bg-slate-100 min-h-screen">

<%- include('../partials/nav') %>

<!-- HERO -->

<section class="bg-gradient-to-r from-rose-600 to-rose-500 text-white">

  <div class="max-w-7xl mx-auto px-4 py-24 text-center">
<h1 class="text-5xl md:text-7xl font-bold mb-6">
  Discover Your Perfect Getaway
</h1>

<p class="text-xl md:text-2xl max-w-3xl mx-auto text-rose-100">
  Explore premium properties and book unforgettable experiences.
</p>

<% if (!isLoggedIn) { %>

  <div class="mt-8">
    <a
      href="/auth/signup"
      class="inline-block bg-white text-rose-600 px-8 py-4 rounded-xl font-semibold hover:bg-slate-100 transition"
    >
      Start Exploring
    </a>
  </div>

<% } %>


  </div>

</section>

<!-- STATS -->

<section class="bg-white">

  <div class="max-w-7xl mx-auto px-4 py-12">


<div class="grid md:grid-cols-3 gap-8 text-center">

  <div>
    <h3 class="text-5xl font-bold text-rose-600">
      <%= registeredHomes.length %>
    </h3>

    <p class="text-slate-600 mt-2">
      Premium Properties
    </p>
  </div>

  <div>
    <h3 class="text-5xl font-bold text-rose-600">
      24/7
    </h3>

    <p class="text-slate-600 mt-2">
      Customer Support
    </p>
  </div>

  <div>
    <h3 class="text-5xl font-bold text-rose-600">
      100%
    </h3>

    <p class="text-slate-600 mt-2">
      Trusted & Verified
    </p>
  </div>

</div>


  </div>

</section>

<!-- FEATURED HOMES -->

<section class="max-w-7xl mx-auto px-4 py-16">

  <div class="text-center mb-12">


<span class="inline-block bg-rose-100 text-rose-600 px-4 py-2 rounded-full text-sm font-semibold mb-4">
  FEATURED COLLECTION
</span>

<h2 class="text-4xl font-bold text-slate-900 mb-3">
  Handpicked Properties
</h2>

<p class="text-slate-600 text-lg">
  Carefully curated homes waiting for your next adventure
</p>


  </div>

<% if (registeredHomes.length === 0) { %>


<div class="bg-white rounded-2xl shadow-lg p-12 text-center">

  <div class="text-7xl mb-6">
    🏠
  </div>

  <h3 class="text-3xl font-bold text-slate-900 mb-4">
    No Properties Available
  </h3>

  <p class="text-slate-600">
    Check back soon for amazing vacation homes.
  </p>

</div>


<% } else { %>


<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">

  <% registeredHomes.forEach((home) => { %>

    <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition duration-300">

      <!-- Image -->
      <div class="relative">

        <img
          src="<%= home.photo %>"
          alt="<%= home.homeName %>"
          onerror="this.src='https://placehold.co/600x400?text=Property'"
          class="w-full h-60 object-cover"
        />

        <span class="absolute top-3 right-3 bg-rose-600 text-white text-xs px-3 py-1 rounded-full">
          Featured
        </span>

      </div>

      <!-- Content -->
      <div class="p-6">

        <h3 class="text-xl font-bold text-slate-900 mb-2">
          <%= home.homeName %>
        </h3>

        <p class="text-slate-500 mb-3">
          📍 <%= home.location %>
        </p>

        <% if (home.description) { %>

          <p class="text-slate-600 text-sm mb-4 line-clamp-2">
            <%= home.description %>
          </p>

        <% } %>

        <div class="flex justify-between items-center mb-5">

          <div>
            <p class="text-xs text-slate-500">
              From
            </p>

            <p class="text-xl font-bold text-rose-600">
              ₹<%= home.price %>
            </p>
          </div>

          <div>
            <p class="text-xs text-slate-500">
              Rating
            </p>

            <p class="font-bold text-yellow-500">
              ⭐ <%= home.rating %>
            </p>
          </div>

        </div>

        <a
          href="/store/home/<%= home._id %>"
          class="block text-center bg-rose-600 hover:bg-rose-700 text-white py-3 rounded-lg font-medium transition"
        >
          View Details
        </a>

      </div>

    </div>

  <% }) %>

</div>

<div class="text-center mt-12">

  <a
    href="/homes"
    class="inline-block border border-slate-300 bg-white px-6 py-3 rounded-lg hover:bg-slate-50 transition"
  >
    View All Properties
  </a>

</div>


<% } %>

</section>

<!-- CTA -->

<% if (!isLoggedIn) { %>

<section class="bg-rose-600 text-white">

  <div class="max-w-4xl mx-auto text-center px-4 py-20">


<h2 class="text-4xl font-bold mb-4">
  Ready to Travel?
</h2>

<p class="text-xl text-rose-100 mb-8">
  Join thousands of travelers discovering amazing homes.
</p>

<div class="flex flex-col md:flex-row justify-center gap-4">

  <a
    href="/auth/signup"
    class="bg-white text-rose-600 px-6 py-3 rounded-lg font-semibold"
  >
    Get Started
  </a>

  <a
    href="/auth/login"
    class="border border-white px-6 py-3 rounded-lg"
  >
    Sign In
  </a>

</div>
  </div>

</section>

<% } %>

</body>
</html>
