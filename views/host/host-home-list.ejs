<%- include('../partials/head') %>

</head>

<body class="bg-slate-100 min-h-screen">

<%- include('../partials/nav') %>

<main class="max-w-7xl mx-auto px-4 py-10">

  <!-- Header -->

  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-10">


<div>
  <span class="inline-block px-3 py-1 bg-rose-100 text-rose-600 text-xs font-bold rounded-full mb-3">
    HOST DASHBOARD
  </span>

  <h1 class="text-4xl font-bold text-slate-900">
    My Properties
  </h1>

  <p class="text-slate-600 mt-2">
    Manage and monitor all your listings
  </p>
</div>

<a
  href="/host/add-home"
  class="bg-rose-600 hover:bg-rose-700 text-white px-6 py-3 rounded-lg font-semibold transition"
>
  + Add Property
</a>


  </div>

<% if (registeredHomes.length === 0) { %>


<!-- Empty State -->
<div class="bg-white rounded-2xl shadow-lg p-12 text-center">

  <div class="text-7xl mb-4">🏠</div>

  <h2 class="text-2xl font-bold text-slate-900 mb-3">
    No Properties Listed
  </h2>

  <p class="text-slate-600 mb-6">
    You haven't listed any properties yet.
  </p>

  <a
    href="/host/add-home"
    class="inline-block bg-rose-600 hover:bg-rose-700 text-white px-6 py-3 rounded-lg font-semibold"
  >
    Add Your First Property
  </a>

</div>


<% } else { %>


<!-- Stats -->
<div class="grid md:grid-cols-3 gap-6 mb-10">

  <div class="bg-white rounded-xl shadow p-6">
    <p class="text-sm text-slate-500 mb-2">
      Total Properties
    </p>

    <h3 class="text-4xl font-bold">
      <%= registeredHomes.length %>
    </h3>
  </div>

  <div class="bg-white rounded-xl shadow p-6">
    <p class="text-sm text-slate-500 mb-2">
      Avg Rating
    </p>

    <h3 class="text-4xl font-bold text-yellow-500">
      <%= (registeredHomes.reduce((sum, h) => sum + parseFloat(h.rating || 0), 0) / registeredHomes.length).toFixed(1) %>
    </h3>
  </div>

  <div class="bg-white rounded-xl shadow p-6">
    <p class="text-sm text-slate-500 mb-2">
      Active Listings
    </p>

    <h3 class="text-4xl font-bold text-green-600">
      <%= registeredHomes.length %>
    </h3>
  </div>

</div>

<!-- Properties Grid -->
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">

  <% registeredHomes.forEach((home) => { %>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300">

      <!-- Image -->
      <img
        src="<%= home.photo %>"
        alt="<%= home.homeName %>"
        onerror="this.src='https://placehold.co/600x400?text=Property'"
        class="w-full h-56 object-cover"
      />

      <!-- Content -->
      <div class="p-6">

        <h3 class="text-xl font-bold text-slate-900 mb-2">
          <%= home.homeName %>
        </h3>

        <p class="text-slate-500 mb-4">
          📍 <%= home.location %>
        </p>

        <div class="flex justify-between items-center mb-4">

          <div>
            <p class="text-sm text-slate-500">
              Price/Night
            </p>

            <p class="text-xl font-bold text-rose-600">
              ₹<%= home.price %>
            </p>
          </div>

          <div>
            <p class="text-sm text-slate-500">
              Rating
            </p>

            <p class="font-bold text-yellow-500">
              ⭐ <%= home.rating %>
            </p>
          </div>

        </div>

        <!-- Buttons -->
        <div class="flex gap-3">

          <a
            href="/host/edit-home/<%= home._id %>?editing=true"
            class="flex-1 text-center bg-rose-600 hover:bg-rose-700 text-white py-2 rounded-lg font-medium"
          >
            Edit
          </a>

          <form
            action="/host/delete-home/<%= home._id %>"
            method="POST"
            class="flex-1"
          >

            <button
              type="submit"
              onclick="return confirm('Delete this property permanently?');"
              class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg font-medium"
            >
              Delete
            </button>

          </form>

        </div>

      </div>

    </div>

  <% }) %>

</div>


<% } %>

</main>

</body>
</html>
