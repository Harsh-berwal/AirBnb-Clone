# Server Port
PORT=3000

# Application Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI (Replace with your actual MongoDB connection string)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
DB_PATH=mongodb+srv://<db_username>:<db_password>@<cluster-url>/<db_name>?retryWrites=true&w=majority

# Session Encryption Secret (Use a strong random string in production)
SESSION_SECRET=your_random_session_secret_key_here
